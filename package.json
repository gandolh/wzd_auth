{
  "name": "ward",
  "version": "0.1.0",
  "description": "Ward identity service — Fastify + SQLite auth for the estate.",
  "private": true,
  "type": "module",
  "workspaces": [
    "api",
    "ui",
    "client",
    "docs"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "concurrently --kill-others-on-fail \"npm run dev --workspace=api\"",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "vitest run",
    "lint": "eslint \"api/src/**/*.ts\" \"client/src/**/*.ts\" \"ui/src/**/*.{ts,tsx}\"",
    "fmt": "prettier --write \"api/src/**/*.ts\" \"client/src/**/*.ts\" \"ui/src/**/*.{ts,tsx,css}\" \"ui/index.html\" \"*.md\" \"vitest.config.ts\"",
    "fmt:check": "prettier --check \"api/src/**/*.ts\" \"client/src/**/*.ts\" \"ui/src/**/*.{ts,tsx,css}\" \"ui/index.html\" \"*.md\" \"vitest.config.ts\"",
    "test:watch": "vitest",
    "keygen": "npm run keygen --workspace=api"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "concurrently": "10.0.5",
    "eslint": "10.9.1",
    "eslint-plugin-react-hooks": "7.1.1",
    "prettier": "3.9.6",
    "typescript": "6.0.3",
    "typescript-eslint": "8.69.0",
    "vitest": "4.1.11"
  },
  "author": "",
  "license": "MIT"
}
