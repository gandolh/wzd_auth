  "cards": [
    {
      "dot": "cyan",
      "title": "Why a redirect and not a token relay",
      "items": [
        "Every app is a sub-path on one origin, so a Path=/ cookie is already sent",
        "No CORS, no fragment parsing, no cross-domain handover",
        "?next= is allowlisted — an open redirect here would be an estate-wide one"
      ]
    },
    {
      "dot": "emerald",
      "title": "Two credentials, deliberately unalike",
      "items": [
        "Access: 15-minute EdDSA JWT, verified locally, never checked with Ward",
        "Refresh: opaque 30-day row, rotated on use, scoped to /ward-api/refresh",
        "Signature validity and session liveness are separate questions"
      ]
    },
    {
      "dot": "rose",
      "title": "The 30-second window",
      "items": [
        "Apps cache the introspection answer for 30 seconds",
        "So revoking a session is one write, visible estate-wide within 30 s",
        "That delay is the price of not running a JWT denylist"
      ]
    }
  ]
}
