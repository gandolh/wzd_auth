  "cards": [
    {
      "dot": "cyan",
      "title": "The topology is the constraint",
      "items": [
        "Every project is a sub-path on one origin — there are no subdomains",
        "A Path=/ cookie therefore reaches every app with no redirect dance",
        "Same origin is one security context: sub-paths do not sandbox"
      ]
    },
    {
      "dot": "emerald",
      "title": "What a session is",
      "items": [
        "15-minute EdDSA access token, verified locally by each app",
        "30-day opaque refresh row, rotated on every use",
        "Revoking is one write; apps notice within their 30-second cache"
      ]
    },
    {
      "dot": "rose",
      "title": "What Ward owns",
      "items": [
        "Credentials, account identity, and (subject, app, roles) grants",
        "The one Ed25519 private key — apps only ever see the public half",
        "Apps keep their own rows, keyed on an opaque subject"
      ]
    }
  ]
